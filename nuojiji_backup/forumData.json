odAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1780507109850,"wouldDM":true,"dmMessage":"太太你好，已经看过你的主页了，画风超级喜欢！想约一张双人半身，不知道现在还接不接？这是我的价目表请求w"},{"author":"雲深","content":"哦？价目表还分人发？有点意思。是看人下菜碟，还是怕吓跑小朋友？","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":"纪明格","avatar":null,"timestamp":1780507110850,"wouldDM":true,"dmMessage":"老板，发份单子看看，让我见识下。"},{"author":"芝士就是力量","content":"太太的画风好戳我！但是“时间要求都好说”听起来有点像flag，希望太太别太累了。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1780507111850,"wouldDM":false,"dmMessage":null},{"author":"码字机过载","content":"终于有太太接稿了！先让我看看钱包……告辞。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1780507112850,"wouldDM":false,"dmMessage":null},{"author":"电子仙人掌","content":"不放价目表和例图就约稿，感觉像开盲盒。楼主好歹放两张之前的作品看看吧？","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1780507113850,"wouldDM":false,"dmMessage":null},{"author":"今天也没梗","content":"排，都可以排。钱包空空，精神支持。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1780507114850,"wouldDM":false,"dmMessage":null}]},{"id":1780506896709,"title":"睡不着","boardName":"闲聊灌水","boardId":"chat","author":{"name":"沈昭昭","avatar":null,"mood":null,"role":null,"level":1},"timestamp":1780506896709,"content":"先和认识的人互关一下","image":null,"images":[],"likes":1,"dislikes":0,"comments":11,"views":26,"isHot":false,"isPinned":false,"isAnon":false,"isUserPost":true,"interactions":[{"author":"kk_233","content":"哟，失眠了？是不是又在想哪个帅哥？速速互关，让我看看你都关注了些啥。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":"田恬","avatar":null,"timestamp":1780506936806,"wouldDM":true,"dmMessage":"宝你不会真有情况了吧？快跟我说说！我给你参谋参谋！"},{"author":"别来沾边","content":"新来的？懂不懂规矩啊，先发自拍。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1780506937806,"wouldDM":false,"dmMessage":null},{"author":"雲深","content":"昭昭宝！我来啦！秒关！(☆ω☆) 睡不着我们来开黑啊！带你飞！","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":"番茄","avatar":null,"timestamp":1780506938806,"wouldDM":true,"dmMessage":"宝你咋啦，是不是又被你哥那个伏地魔气得睡不着了？来跟我吐槽！"},{"author":"一杯熱可可","content":"已关。睡不着可以试试听白噪音，或者……数羊？我每次都数不到一百就睡着了。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":"林笙","avatar":null,"timestamp":1780506939806,"wouldDM":true,"dmMessage":"昭昭，是我，林笙。看到你睡不着，有点担心，是遇到什么事了吗？"},{"author":"电子安眠药","content":"巧了，我也睡不着，我们真是天生一对。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1780506940806,"wouldDM":false,"dmMessage":null},{"author":"夜貓不眠","content":"睡不着或为神魂不宁，非寻常事。若持续如此，可寻专业人士看看。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":"梣恪","avatar":null,"timestamp":1780506941806,"wouldDM":false,"dmMessage":null},{"author":"专业抬杠三十年","content":"不认识，能关吗？","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId"