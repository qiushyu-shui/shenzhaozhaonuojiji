[{"userId":"uid_1779020340310_22wjsnrxc","characterId":"09e7f123-74f6-4152-991e-c37790252023","name":"2026/5/17","type":"this-moment","createdAt":1779023431203,"lastActiveAt":1779023431203,"_id":1},{"userId":"uid_1779020340310_22wjsnrxc","characterId":"b63a50c1-ea88-49e4-b760-737e3355ce0c","name":"主卧大床，空调24度，我在这里等你。","type":"this-moment","scenarioOutline":"主卧大床，空调24度，我在这里等你。","sourceContext":{"fromOnlineChat":true,"lastOnlineMessages":[{"role":"char","text":"你过来正好自己拆开看看喜不喜欢"},{"role":"char","text":"昭昭？"},{"role":"char","text":"怎么没动静了"},{"role":"char","text":"是不是吃完饭又睡着了"},{"role":"char","text":"还是说……"},{"role":"char","text":"你还在研究那件湿掉的衣服？"},{"role":"char","text":"[語音消息]"},{"role":"char","text":""},{"role":"user","text":"没有"},{"role":"user","text":"我刚躺好"},{"role":"user","text":"我好了哥哥"},{"role":"char","text":"沈朝正站在主卧的衣帽间门口，手里攥着刚换下的衬衫，看到屏幕亮起的瞬间，他几乎是立刻扔掉了手里的衣服，大步跨向床边。"},{"role":"char","text":"终于好了"},{"role":"char","text":"我还以为你吃着吃着把自己给炖了"},{"role":"char","text":"他单手解开领口的第二颗纽扣，呼吸沉了沉，眼神盯着屏幕上那个“好了”，喉结不自觉地滑动，原本清冷的声线此时磁性得有些过分。"},{"role":"char","text":"[語音消息]"},{"role":"char","text":"一"},{"role":"char","text":"二"},{"role":"char","text":"三"},{"role":"char","text":""}]},"createdAt":1780212453919,"lastActiveAt":1780249172950,"_id":9}]