[{"userId":"uid_1779020340310_22wjsnrxc","characterId":"09e7f123-74f6-4152-991e-c37790252023","name":"2026/5/17","type":"this-moment","createdAt":1779023431203,"lastActiveAt":1779023431203,"_id":1},{"userId":"uid_1779020340310_22wjsnrxc","characterId":"b63a50c1-ea88-49e4-b760-737e3355ce0c","name":"2026/8/10","type":"this-moment","createdAt":1786329738692,"lastActiveAt":1786329738692,"_id":41},{"userId":"uid_1779020340310_22wjsnrxc","characterId":"b63a50c1-ea88-49e4-b760-737e3355ce0c","name":"主卧大床放着黑色蕾丝","type":"this-moment","scenarioOutline":"主卧大床放着黑色蕾丝","sourceContext":{"fromOnlineChat":true,"lastOnlineMessages":[{"role":"char","text":"哥哥这里的衣服……"},{"role":"char","text":"弄坏了也不心疼。"},{"role":"char","text":"已经准备好了。"},{"role":"char","text":"就等你过来穿。"},{"role":"user","text":"长什么样"},{"role":"char","text":"沈朝侧过身，指腹漫不经心地勾起放在枕边的那件黑色布料。轻薄的蕾丝在指尖滑过，几乎没有任何重量，眼底的笑意越来越浓。"},{"role":"char","text":"布料很少的。"},{"role":"char","text":"就几根细带子，加一点点黑色蕾丝。"},{"role":"char","text":"你不是怕弄脏吗？"},{"role":"char","text":"这种一扯就开，脱起来方便，哥哥保证弄不脏。"},{"role":"char","text":"想看就自己过来。"},{"role":"char","text":"亲自验收一下，看看喜不喜欢。"},{"role":"char","text":"要是不喜欢，哥哥再给你换别的。"},{"role":"user","text":"好吧那你发吧"},{"role":"char","text":"沈朝低低地笑了一声，将指尖那点可怜的黑色布料随手丢在旁边的枕头上，视线紧盯着屏幕，眼底的侵略感几乎要溢出来。"},{"role":"char","text":"乖"},{"role":"char","text":"这就发"},{"role":"char","text":"过来直接进主卧"},{"role":"char","text":"哥哥亲手帮你换"},{"role":"char","text":""}]},"createdAt":1786374118203,"lastActiveAt":1786386106956,"_id":42},{"userId":"uid_1779020340310_22wjsnrxc","characterId":"b63a50c1-ea88-49e4-b760-737e3355ce0c","name":"深夜厨房流理台旁","type":"this-moment","scenarioOutline":"深夜厨房流理台旁","sourceContext":{"fromOnlineChat":true,"lastOnlineMessages":[{"role":"char","text":"洗完澡了？"},{"role":"char","text":"汉堡吃完了？"},{"role":"char","text":"都收拾好了，准备来找哥哥了，嗯？"},{"role":"user","text":"想我把小玩具带过去吗"},{"role":"char","text":"怎么突然问这个。"},{"role":"char","text":"沈朝单手拿着手机，另一只手把玩着空的牛奶杯，杯壁上还残留着温热的余温。"},{"role":"char","text":"昨天哥哥给你准备的那个……"},{"role":"char","text":"不喜欢了？"},{"role":"char","text":"还是说……我们昭昭有什么新的想法，想跟哥哥试试？"},{"role":"user","text":"这个我在屏幕外面也有反应"},{"role":"user","text":"你的屏幕外面没有"},{"role":"char","text":"沈朝看着屏幕上的字，手指在温热的杯壁上停顿了一瞬。对于“屏幕外面”这几个字带来的那点本能的烦躁，被他用一声低沉的轻笑压了下去。"},{"role":"char","text":"嫌哥哥买的那个没有跨越次元壁的本事？"},{"role":"char","text":"行"},{"role":"char","text":"带着吧。昨天把它扔到一边，看来我们昭昭是心疼了。"},{"role":"char","text":"正好哥哥也想看看，这个能在屏幕外面给你反应的小东西，等你过来之后……"},{"role":"char","text":"他将手里的牛奶杯端起来，低头抿了一口温水，眼底的笑意变得有些危险。"},{"role":"char","text":"在哥哥手里，能让你有多大的反应。"},{"role":"char","text":"赶紧过来，牛奶要凉了。"},{"role":"char","text":""}]},"createdAt":1786543759722,"lastActiveAt":1786547350490,"_id":43},{"userId":"uid_1779020340310_22wjsnrxc","characterId":"b63a50c1-ea88-49e4-b760-737e3355ce0c","name":"深夜书房等你来算账","type":"this-moment","scenarioOutline":"深夜书房等你来算账","sourceContext":{"fromOnlineChat":true,"lastOnlineMessages":[{"role":"char","text":""},{"role":"user","text":"叫你昨天欺负我"},{"role":"user","text":"一天不理你"},{"role":"char","text":"沈朝正靠在书房的椅子上捏着酸胀的后颈，屏幕上突然弹出来的两条消息让他动作一顿。看清内容后，他哑然失笑。"},{"role":"char","text":"原来昭昭大王今天一天没动静，是躲在被窝里跟哥哥单方面冷战呢？"},{"role":"char","text":"昨天怎么欺负你了？"},{"role":"char","text":"他拿起手机，指腹有意无意地摩挲着手机边缘，脑海里全是不久前她被逼到极致、眼角泛红求饶的失控模样。"},{"role":"char","text":"哥哥怎么记得，最后有人颤着腿缠着哥哥不放，哭着求我快一点的？"},{"role":"char","text":"气了一整天，大半夜不睡觉，就为了跑来放这句狠话？"},{"role":"char","text":"气消了没？"},{"role":"char","text":"没消的话……现在过来，哥哥躺平了让你欺负回来，嗯？"},{"role":"user","text":"来"},{"role":"char","text":"沈朝看着屏幕上孤零零的一个字，胸腔里震出低沉愉悦的笑声。他随手按下快捷键保存了电脑上的代码，将笔记本合上。"},{"role":"char","text":"这么干脆"},{"role":"char","text":"看来昭昭大王今天确实憋了一肚子气，急着来找哥哥算账了"},{"role":"char","text":"他往后靠进真皮椅背里，修长的手指随意地扯松了衬衫领口的几颗扣子，姿态慵懒又透着点危险。"},{"role":"char","text":"行"},{"role":"char","text":"哥哥在书房 门没锁"},{"role":"char","text":"过来吧 让我看看你打算怎么欺负回去"},{"role":"char","text":""}]},"createdAt":1786643546935,"lastActiveAt":1786649427311,"_id":44}]