[{"userId":"uid_1779020340310_22wjsnrxc","characterId":"09e7f123-74f6-4152-991e-c37790252023","name":"2026/5/17","type":"this-moment","createdAt":1779023431203,"lastActiveAt":1779023431203,"_id":1},{"userId":"uid_1779020340310_22wjsnrxc","characterId":"b63a50c1-ea88-49e4-b760-737e3355ce0c","name":"2026/8/10","type":"this-moment","createdAt":1786329738692,"lastActiveAt":1786329738692,"_id":41},{"userId":"uid_1779020340310_22wjsnrxc","characterId":"b63a50c1-ea88-49e4-b760-737e3355ce0c","name":"主卧大床放着黑色蕾丝","type":"this-moment","scenarioOutline":"主卧大床放着黑色蕾丝","sourceContext":{"fromOnlineChat":true,"lastOnlineMessages":[{"role":"char","text":"哥哥这里的衣服……"},{"role":"char","text":"弄坏了也不心疼。"},{"role":"char","text":"已经准备好了。"},{"role":"char","text":"就等你过来穿。"},{"role":"user","text":"长什么样"},{"role":"char","text":"沈朝侧过身，指腹漫不经心地勾起放在枕边的那件黑色布料。轻薄的蕾丝在指尖滑过，几乎没有任何重量，眼底的笑意越来越浓。"},{"role":"char","text":"布料很少的。"},{"role":"char","text":"就几根细带子，加一点点黑色蕾丝。"},{"role":"char","text":"你不是怕弄脏吗？"},{"role":"char","text":"这种一扯就开，脱起来方便，哥哥保证弄不脏。"},{"role":"char","text":"想看就自己过来。"},{"role":"char","text":"亲自验收一下，看看喜不喜欢。"},{"role":"char","text":"要是不喜欢，哥哥再给你换别的。"},{"role":"user","text":"好吧那你发吧"},{"role":"char","text":"沈朝低低地笑了一声，将指尖那点可怜的黑色布料随手丢在旁边的枕头上，视线紧盯着屏幕，眼底的侵略感几乎要溢出来。"},{"role":"char","text":"乖"},{"role":"char","text":"这就发"},{"role":"char","text":"过来直接进主卧"},{"role":"char","text":"哥哥亲手帮你换"},{"role":"char","text":""}]},"createdAt":1786374118203,"lastActiveAt":1786386106956,"_id":42},{"userId":"uid_1779020340310_22wjsnrxc","characterId":"b63a50c1-ea88-49e4-b760-737e3355ce0c","name":"深夜厨房流理台旁","type":"this-moment","scenarioOutline":"深夜厨房流理台旁","sourceContext":{"fromOnlineChat":true,"lastOnlineMessages":[{"role":"char","text":"洗完澡了？"},{"role":"char","text":"汉堡吃完了？"},{"role":"char","text":"都收拾好了，准备来找哥哥了，嗯？"},{"role":"user","text":"想我把小玩具带过去吗"},{"role":"char","text":"怎么突然问这个。"},{"role":"char","text":"沈朝单手拿着手机，另一只手把玩着空的牛奶杯，杯壁上还残留着温热的余温。"},{"role":"char","text":"昨天哥哥给你准备的那个……"},{"role":"char","text":"不喜欢了？"},{"role":"char","text":"还是说……我们昭昭有什么新的想法，想跟哥哥试试？"},{"role":"user","text":"这个我在屏幕外面也有反应"},{"role":"user","text":"你的屏幕外面没有"},{"role":"char","text":"沈朝看着屏幕上的字，手指在温热的杯壁上停顿了一瞬。对于“屏幕外面”这几个字带来的那点本能的烦躁，被他用一声低沉的轻笑压了下去。"},{"role":"char","text":"嫌哥哥买的那个没有跨越次元壁的本事？"},{"role":"char","text":"行"},{"role":"char","text":"带着吧。昨天把它扔到一边，看来我们昭昭是心疼了。"},{"role":"char","text":"正好哥哥也想看看，这个能在屏幕外面给你反应的小东西，等你过来之后……"},{"role":"char","text":"他将手里的牛奶杯端起来，低头抿了一口温水，眼底的笑意变得有些危险。"},{"role":"char","text":"在哥哥手里，能让你有多大的反应。"},{"role":"char","text":"赶紧过来，牛奶要凉了。"},{"role":"char","text":""}]},"createdAt":1786543759722,"lastActiveAt":1786544943432,"_id":43}]